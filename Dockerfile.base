FROM debian:bookworm-slim

ARG BUN_VERSION=1.3.14

ENV DEBIAN_FRONTEND=noninteractive

# This layer rarely changes and is built as a separate base image so that a
# --no-cache rebuild (to pull the latest pi) does not force a full re-fetch of
# these apt dependencies.
RUN apt-get update && apt-get install -y \
  aggregate \
  file \
  bc \
  binutils \
  bubblewrap \
  cmake \
  curl \
  direnv \
  dnsutils \
  fd-find \
  fzf \
  gh \
  git \
  gnupg2 \
  imagemagick \
  iproute2 \
  ipset \
  iptables \
  jq \
  less \
  libasound2 \
  libatk1.0-0 \
  libatk-bridge2.0-0 \
  libatspi2.0-0 \
  libcairo2 \
  libcups2 \
  libdbus-1-3 \
  libdrm2 \
  libgbm1 \
  libgdk-pixbuf-2.0-0 \
  libglib2.0-0 \
  libgtk-3-0 \
  libnspr4 \
  libnss3 \
  libpango-1.0-0 \
  libpangocairo-1.0-0 \
  libwayland-client0 \
  libx11-6 \
  libx11-xcb1 \
  libxcb1 \
  libxcb-dri3-0 \
  libxcomposite1 \
  libxcursor1 \
  libxdamage1 \
  libxext6 \
  libxfixes3 \
  libxi6 \
  libxkbcommon0 \
  libxrandr2 \
  libxrender1 \
  libxshmfence1 \
  libxss1 \
  libxtst6 \
  lsof \
  man-db \
  moreutils \
  ninja-build \
  parallel \
  poppler-utils \
  procps \
  pv \
  python3 \
  ripgrep \
  socat \
  sqlite3 \
  strace \
  sudo \
  unzip \
  wget \
  xxd \
  xz-utils \
  && rm -rf /var/lib/apt/lists/*

# Install bun from the official GitHub release.
# bun can also run as node, npm, and npx when invoked under those names.
RUN set -eux && \
    ARCH=$(uname -m) && \
    case "$ARCH" in \
      x86_64)  TARGET="bun-linux-x64" ;; \
      aarch64) TARGET="bun-linux-aarch64" ;; \
      *) echo "Unsupported architecture: $ARCH" >&2; exit 1 ;; \
    esac && \
    curl -fsSL "https://github.com/oven-sh/bun/releases/download/bun-v${BUN_VERSION}/${TARGET}.zip" \
      -o /tmp/bun.zip && \
    unzip /tmp/bun.zip -d /tmp && \
    mv "/tmp/${TARGET}/bun" /usr/local/bin/bun && \
    chmod +x /usr/local/bin/bun && \
    rm -rf /tmp/bun.zip "/tmp/${TARGET}" && \
    bun --version && \
    ln -sf /usr/local/bin/bun /usr/local/bin/node && \
    ln -sf /usr/local/bin/bun /usr/local/bin/npm && \
    ln -sf /usr/local/bin/bun /usr/local/bin/npx

# Download the agent-browser binary from GitHub releases and install it.
# Uses the musl variant for maximum portability inside the container.
RUN set -eux && \
    ARCH=$(uname -m) && \
    case "$ARCH" in \
      x86_64)  TARGET="linux-musl-x64" ;; \
      aarch64) TARGET="linux-musl-arm64" ;; \
      *) echo "Unsupported architecture: $ARCH" >&2; exit 1 ;; \
    esac && \
    TAG=$(curl -fsSL https://api.github.com/repos/vercel-labs/agent-browser/releases/latest \
          | jq -r .tag_name) && \
    curl -fsSL "https://github.com/vercel-labs/agent-browser/releases/download/${TAG}/agent-browser-${TARGET}" \
      -o /usr/local/bin/agent-browser && \
    chmod +x /usr/local/bin/agent-browser && \
    agent-browser --version

# Stable path for the Chromium binary cache, independent of any runtime user's
# home directory.  The pi Dockerfile chowns this to the runtime user.
RUN mkdir -p /opt/browser-cache

# Point Playwright (used by agent-browser) at the fixed cache path.
# This env var is inherited by every image that builds FROM this one.
ENV PLAYWRIGHT_BROWSERS_PATH="/opt/browser-cache"

RUN agent-browser install
