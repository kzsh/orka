FROM debian:bookworm-slim

ARG BUN_VERSION=1.3.14

# Revision of the Chromium build Playwright publishes, used on arm64 only.
# Current values are listed in playwright-core/browsers.json.
ARG PLAYWRIGHT_CHROMIUM_REVISION=1237

# Set by BuildKit to the architecture the image is being built for, which is not
# the builder's own architecture when cross-building with --platform.  Layers
# below fall back to `dpkg --print-architecture`, which uses the same vocabulary
# (amd64, arm64) and reports the image's architecture, for the legacy builder
# where this argument is unset.
ARG TARGETARCH

ENV DEBIAN_FRONTEND=noninteractive

# This layer rarely changes and is built as a separate base image so that a
# --no-cache rebuild (to pull the latest pi) does not force a full re-fetch of
# these apt dependencies.
RUN apt-get update && apt-get install -y \
  aggregate \
  file \
  bc \
  binutils \
  bubblewrap \
  cmake \
  curl \
  direnv \
  dnsutils \
  fd-find \
  fzf \
  gh \
  git \
  gnupg2 \
  imagemagick \
  iproute2 \
  ipset \
  iptables \
  jq \
  less \
  libasound2 \
  libatk1.0-0 \
  libatk-bridge2.0-0 \
  libatspi2.0-0 \
  libcairo2 \
  libcups2 \
  libdbus-1-3 \
  libdrm2 \
  libexpat1 \
  libgbm1 \
  libgdk-pixbuf-2.0-0 \
  libglib2.0-0 \
  libgtk-3-0 \
  libnspr4 \
  libnss3 \
  libpango-1.0-0 \
  libpangocairo-1.0-0 \
  libudev1 \
  libwayland-client0 \
  libx11-6 \
  libx11-xcb1 \
  libxcb1 \
  libxcb-dri3-0 \
  libxcomposite1 \
  libxcursor1 \
  libxdamage1 \
  libxext6 \
  libxfixes3 \
  libxi6 \
  libxkbcommon0 \
  libxrandr2 \
  libxrender1 \
  libxshmfence1 \
  libxss1 \
  libxtst6 \
  lsof \
  man-db \
  moreutils \
  ninja-build \
  parallel \
  poppler-utils \
  procps \
  pv \
  python3 \
  ripgrep \
  socat \
  sqlite3 \
  strace \
  sudo \
  unzip \
  wget \
  xxd \
  xz-utils \
  && rm -rf /var/lib/apt/lists/*

# Install bun from the official GitHub release.
# bun can also run as node, npm, and npx when invoked under those names.
RUN set -eux && \
    ARCH="${TARGETARCH:-$(dpkg --print-architecture)}" && \
    case "$ARCH" in \
      amd64) TARGET="bun-linux-x64" ;; \
      arm64) TARGET="bun-linux-aarch64" ;; \
      *) echo "Unsupported architecture: $ARCH" >&2; exit 1 ;; \
    esac && \
    curl -fsSL "https://github.com/oven-sh/bun/releases/download/bun-v${BUN_VERSION}/${TARGET}.zip" \
      -o /tmp/bun.zip && \
    unzip /tmp/bun.zip -d /tmp && \
    mv "/tmp/${TARGET}/bun" /usr/local/bin/bun && \
    chmod +x /usr/local/bin/bun && \
    rm -rf /tmp/bun.zip "/tmp/${TARGET}" && \
    bun --version && \
    ln -sf /usr/local/bin/bun /usr/local/bin/node && \
    ln -sf /usr/local/bin/bun /usr/local/bin/npm && \
    ln -sf /usr/local/bin/bun /usr/local/bin/npx

# Download the agent-browser binary from GitHub releases and install it.
# Uses the musl variant for maximum portability inside the container.
RUN set -eux && \
    ARCH="${TARGETARCH:-$(dpkg --print-architecture)}" && \
    case "$ARCH" in \
      amd64) TARGET="linux-musl-x64" ;; \
      arm64) TARGET="linux-musl-arm64" ;; \
      *) echo "Unsupported architecture: $ARCH" >&2; exit 1 ;; \
    esac && \
    TAG=$(curl -fsSL https://api.github.com/repos/vercel-labs/agent-browser/releases/latest \
          | jq -r .tag_name) && \
    curl -fsSL "https://github.com/vercel-labs/agent-browser/releases/download/${TAG}/agent-browser-${TARGET}" \
      -o /usr/local/bin/agent-browser && \
    chmod +x /usr/local/bin/agent-browser && \
    agent-browser --version

# `agent-browser install` downloads Chrome for Testing into
# $HOME/.agent-browser/browsers.  Running it as root would hide the download in
# /root, so install under a throwaway HOME and relocate the result to a stable,
# world-readable path.  AGENT_BROWSER_EXECUTABLE_PATH then points every runtime
# user at that binary regardless of their own home directory.
#
# Chrome for Testing has no Linux arm64 builds, so arm64 uses the Chromium build
# Playwright publishes instead.  Its runtime libraries are already in the apt
# layer above.  Either way the browser ends up under /opt/browser-cache with a
# `chrome` symlink at a fixed path.
RUN set -eux && \
    mkdir -p /opt/browser-cache && \
    ARCH="${TARGETARCH:-$(dpkg --print-architecture)}" && \
    case "$ARCH" in \
      amd64) \
        HOME=/tmp/agent-browser-install agent-browser install && \
        mv /tmp/agent-browser-install/.agent-browser/browsers/* /opt/browser-cache/ && \
        rm -rf /tmp/agent-browser-install \
        ;; \
      arm64) \
        curl -fsSL "https://cdn.playwright.dev/dbazure/download/playwright/builds/chromium/${PLAYWRIGHT_CHROMIUM_REVISION}/chromium-linux-arm64.zip" \
          -o /tmp/chromium.zip && \
        unzip -q /tmp/chromium.zip -d /opt/browser-cache && \
        rm -f /tmp/chromium.zip \
        ;; \
      *) echo "No Chromium build available for $ARCH" >&2; exit 1 ;; \
    esac && \
    CHROME=$(find /opt/browser-cache -maxdepth 2 -type f -name chrome | head -n 1) && \
    test -n "$CHROME" && \
    chmod a+x "$CHROME" && \
    for helper in chrome_sandbox chrome_crashpad_handler; do \
      [ -f "$(dirname "$CHROME")/$helper" ] && chmod a+x "$(dirname "$CHROME")/$helper"; \
      true; \
    done && \
    ln -s "$CHROME" /opt/browser-cache/chrome && \
    chmod -R a+rX /opt/browser-cache

# Inherited by every image that builds FROM this one.
ENV AGENT_BROWSER_EXECUTABLE_PATH="/opt/browser-cache/chrome"
