# Intermediate layer between the apt base and the final pi image.
# Downloads the agent-browser binary and its Chromium dependency into
# /opt/browser-cache so that rebuilding the final image (to pull the latest pi)
# does not trigger a fresh download every time.
#
# Rebuild this image only when you want a newer version of agent-browser.

ARG BASE_IMAGE=orka-base:latest
FROM ${BASE_IMAGE}

ARG VERSION=latest

# Chromium system library dependencies.  Must run as root.
RUN apt-get update && apt-get install -y --no-install-recommends \
      libatk1.0-0 \
      libatk-bridge2.0-0 \
      libatspi2.0-0 \
      libcairo2 \
      libcups2 \
      libdbus-1-3 \
      libdrm2 \
      libgbm1 \
      libgdk-pixbuf-2.0-0 \
      libglib2.0-0 \
      libgtk-3-0 \
      libnspr4 \
      libnss3 \
      libpango-1.0-0 \
      libpangocairo-1.0-0 \
      libwayland-client0 \
      libx11-6 \
      libx11-xcb1 \
      libxcb1 \
      libxcb-dri3-0 \
      libxcomposite1 \
      libxcursor1 \
      libxdamage1 \
      libxext6 \
      libxfixes3 \
      libxi6 \
      libxkbcommon0 \
      libxrandr2 \
      libxrender1 \
      libxshmfence1 \
      libxss1 \
      libxtst6 \
      libasound2 \
    && rm -rf /var/lib/apt/lists/*

# Download the agent-browser binary from GitHub releases and install it.
# Uses the musl variant for maximum portability inside the container.
RUN set -eux && \
    ARCH=$(uname -m) && \
    case "$ARCH" in \
      x86_64)  TARGET="linux-musl-x64" ;; \
      aarch64) TARGET="linux-musl-arm64" ;; \
      *) echo "Unsupported architecture: $ARCH" >&2; exit 1 ;; \
    esac && \
    if [ "$VERSION" = "latest" ]; then \
      TAG=$(curl -fsSL https://api.github.com/repos/vercel-labs/agent-browser/releases/latest \
            | jq -r .tag_name); \
    else \
      TAG="v${VERSION}"; \
    fi && \
    curl -fsSL "https://github.com/vercel-labs/agent-browser/releases/download/${TAG}/agent-browser-${TARGET}" \
      -o /usr/local/bin/agent-browser && \
    chmod +x /usr/local/bin/agent-browser && \
    agent-browser --version

# Create a stable, home-independent directory for the Chromium binary cache.
# The runtime user gets ownership in the main Dockerfile via chown -R.
RUN mkdir -p /opt/browser-cache

# Point Playwright (used by agent-browser) at a fixed path so Chromium lands
# in the image at a location independent of the runtime user's home directory.
ENV PLAYWRIGHT_BROWSERS_PATH="/opt/browser-cache"

RUN agent-browser install
